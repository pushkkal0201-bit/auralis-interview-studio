# One of these keys enables real GPT-OSS inference. Keep .env private.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fireworks-ai
# Hugging Face Inference Providers may require billing or credits for particular models.
# Audio transcription uses GROQ_API_KEY (optional if using browser STT or typing).
# AURALIS_DATA_DIR=C:/Users/you/AuralisData

# Delete local interview sessions older than N days when the server starts; 0 disables
AURALIS_RETENTION_DAYS=30

# Per-account AI request budget in hosted mode (process-wide in local mode)
AURALIS_MAX_CALLS_PER_MINUTE=15
AURALIS_MAX_CALLS_PER_HOUR=90

# CLOUD-ONLY (Render; do not commit .env)
# AURALIS_DEPLOYMENT_MODE=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/auralis?sslmode=require
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PROJECT_KEY
# AURALIS_PUBLIC_URL=https://your-service.onrender.com
# AURALIS_EXTRA_HOSTS=yourdomain.com

# Cloud global limits across all accounts, transactionally stored in PostgreSQL
# AURALIS_GLOBAL_CALLS_PER_MINUTE=60
# AURALIS_GLOBAL_CALLS_PER_HOUR=500
# Instructor Supabase Auth UUID allowlist; empty means no hosted instructor can create cohorts
# AURALIS_COLLEGE_INSTRUCTOR_IDS=00000000-0000-4000-8000-000000000001
# Supabase legacy service_role admin secret: required only for self-service account closure.
# This highly privileged secret must be set ONLY in Render's private environment, never in JS.
# SUPABASE_SERVICE_ROLE_KEY=

# Security audit follow-up: separate, database-backed signup/login/recovery throttles.
# Accounts: maximum unsuccessful OR successful requests per endpoint and identity / 15 min.
AURALIS_AUTH_ATTEMPTS_PER_15M=8
# Across all account operations in one minute. Also use trusted edge WAF limits.
AURALIS_AUTH_GLOBAL_PER_MINUTE=90

# Schedule: run `python -m scripts.retention_maintenance` daily using managed
# cron credentials. Application startup cleanup is not a retention guarantee.
